# ============================================================
# Monevo — Environment Variables
# Copy this file to .env and fill in the real values.
# Never commit .env to version control.
# ============================================================

# ── Application ─────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── MongoDB ─────────────────────────────────────────────────
# Get from: MongoDB Atlas → Cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ── AssemblyAI ───────────────────────────────────────────────
# Get from: https://www.assemblyai.com/dashboard → API Keys
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ── Groq AI (Llama 3.3 & Whisper) ───────────────────────────
# Get from: https://console.groq.com → API Keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── Anthropic (Claude AI - Optional Fallback) ───────────────
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Kapso WhatsApp Integration ──────────────────────────────
# API key from Kapso dashboard (https://app.kapso.ai)
KAPSO_API_KEY=your_kapso_api_key_here
# Base URL (default: https://api.kapso.ai)
KAPSO_API_BASE_URL=https://api.kapso.ai
# Kapso project and WhatsApp configuration IDs
KAPSO_PROJECT_ID=your_kapso_project_id
KAPSO_WHATSAPP_CONFIG_ID=your_kapso_whatsapp_config_id
# Webhook secret for signature verification (optional)
KAPSO_WEBHOOK_SECRET=your_kapso_webhook_secret

# ── Meta WhatsApp Cloud API / Proxy ──────────────────────────
# Phone Number ID shown in Kapso / Meta WhatsApp setup
META_WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Webhook verify token for verification challenge
META_WHATSAPP_VERIFY_TOKEN=your_verify_token_here

# WhatsApp Business Account ID (WABA ID)
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id

# Meta Graph API version used by Kapso proxy (default: v24.0)
META_GRAPH_API_VERSION=v24.0

# Optional fallback Meta access token when not using Kapso
META_WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token
